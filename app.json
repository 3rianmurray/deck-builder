{
  "expo": {
    "name": "Shufflevale",
    "slug": "card-table",
    "scheme": "shufflevale",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#14161a",
    "ios": {
      "backgroundColor": "#14161a",
      "bundleIdentifier": "com.3rianmurray.shufflevale",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14161a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Shufflevale uses your photo library so you can turn your own artwork into cards.",
          "cameraPermission": "Shufflevale uses your camera so you can photograph your own artwork and turn it into cards.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-sharing",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Shufflevale uses your camera so you can photograph your own artwork and turn it into cards."
        }
      ],
      "expo-iap",
      "expo-system-ui"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "efcb9485-e756-46e8-b531-6361bc1b39ef"
      }
    },
    "owner": "3rianmurray",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/efcb9485-e756-46e8-b531-6361bc1b39ef"
    }
  }
}
